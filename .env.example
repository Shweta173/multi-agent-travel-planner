# Groq API key for the LLM (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key

# Tavily API key for hotel search (https://app.tavily.com)
TAVILY_API_KEY=your_tavily_api_key

# Aviationstack API key for flight data (https://aviationstack.com)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# PostgreSQL connection string for LangGraph checkpoints
DATABASE_URL=postgresql://user:password@localhost:5432/travel_planner
